# Configuración opcional del sistema.
#
# El sistema funciona sin este archivo: todos los valores tienen un valor por
# defecto pensado para el uso local (localhost). Para cambiar alguno, copie
# este archivo con el nombre `.env` (en la misma carpeta que manage.py),
# quite el `#` de la línea y ajuste el valor. El archivo `.env` no se sube a
# GitHub.

# Modo de depuración. Solo para quien programa: muestra páginas técnicas de
# error con detalles internos. Nunca lo active con datos reales.
# DEBUG=True

# Clave secreta de la instalación. Si no se define, el sistema crea una
# aleatoria en el archivo `.secret_key` la primera vez que arranca.
# SECRET_KEY=una-clave-larga-y-aleatoria

# Direcciones desde las que se puede abrir el sistema (separadas por comas).
# ALLOWED_HOSTS=127.0.0.1,localhost

# Muestra siempre el aviso de "Datos de prueba", aunque la base no tenga los
# usuarios ficticios del comando seed.
# DATOS_PRUEBA=True

# Base de datos. Por defecto SQLite en el archivo db.sqlite3 (ADR 0002).
# DB_NAME=C:/ruta/a/otra/base.sqlite3
#
# Para un servidor MySQL/MariaDB (trabajo futuro del ADR 0002), además hay que
# instalar el conector con `py -m pip install mysqlclient`:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=sga
# DB_USER=usuario
# DB_PASSWORD=contraseña
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Solo si el sistema se publica detrás de HTTPS: activa cookies seguras,
# redirección a HTTPS y HSTS.
# HTTPS=True
